.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env

# weights are fetched, not committed; the manifest and the E1 class means are
models/*
!models/manifest.json
!models/class_means.json
# the E3 adjacency is hand-authored source, not a fetched weight: it is the
# sole independent variable of RSCH-3 and config.json pins its sha256
!models/graph_edge_schemes/

# data is fetched, not committed; each dataset's README is the contract
data/*
!data/cat-emotions-3/
data/cat-emotions-3/*
!data/cat-emotions-3/README.txt

!data/cat-emotions-7/
data/cat-emotions-7/*
!data/cat-emotions-7/README.txt

!data/catflw/
data/catflw/*
!data/catflw/CatFLW dataset/
data/catflw/CatFLW dataset/*
!data/catflw/CatFLW dataset/README.txt

!data/cache/
data/cache/*
!data/cache/README.md
!data/cache/splits.csv
!data/cache/overlays/
data/cache/overlays/*
!data/cache/overlays/overlay.csv
